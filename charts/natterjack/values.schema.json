{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Natterjack Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clusterName": {
      "type": "string",
      "pattern": "^([A-Za-z0-9][-A-Za-z0-9_.]*)?$",
      "maxLength": 255
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resync": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "type": "string",
              "pattern": "^([a-z]{2}(-gov|-iso[a-z]?)?-[a-z]+-[0-9])?$"
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
              "maxLength": 63
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "error"
          ]
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "health": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "excludedCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "markMask": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{1,8}$"
        },
        "routeTableBase": {
          "type": "integer",
          "minimum": 256
        },
        "rulePriority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32763
        },
        "tunnelPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "probePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "gatewayLink": {
          "type": "string",
          "pattern": "^169\\.254\\.[0-9]{1,3}\\.[0-9]{1,3}/30$"
        },
        "mss": {
          "type": "integer",
          "minimum": 536,
          "maximum": 65535
        },
        "stateDir": {
          "type": "string",
          "pattern": "^/[^\\s]*$"
        },
        "selfTest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
            }
          }
        },
        "resync": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "error"
          ]
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "health": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "updateStrategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
              "maxLength": 63
            }
          }
        }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
